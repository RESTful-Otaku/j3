# J3 environment template — safe to commit. Copy to .env.local (git-ignored).
# Nothing in this file is a secret. Replace every CHANGE_ME value locally or in
# GitHub repo Settings → Secrets and variables → Actions as described below.
# Load locally with: set -a; source .env.local; set +a

# ---------------------------------------------------------------------------
# QA / local demo defaults (what `bun run dev` and the APK smoke tests use)
# ---------------------------------------------------------------------------
J3_ADDR=127.0.0.1:8787
J3_DB=./data/j3.db
J3_VERSION=dev
J3_SEED_DEMO=1
J3_DEMO=1
J3_OWNER_EMAIL=j3@local
J3_OWNER_NAME=J3 Owner
# Leave blank in QA. J3 logs a one-time password and forces a change on first login.
J3_OWNER_PASSWORD=
J3_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Mobile client build inputs. Blank VITE_API_BASE_URL means same-origin API.
J3_SERVER_URL=
VITE_API_BASE_URL=
VITE_OFFLINE_DEMO=1
VITE_QA_AUTOLOGIN=1

# Containerised QA demo (scripts/qa-docker.sh; Docker or Podman).
# J3_API_PORT=8787
# J3_WEB_PORT=5173
# J3_SIM_SEED=42
# J3_SIM_FIGHTERS=50
# J3_CONTAINER_RUNTIME=podman   # auto-detected when blank

# ---------------------------------------------------------------------------
# Hosted production — override the QA values above
# ---------------------------------------------------------------------------
# Server flags/env: set J3_SEED_DEMO=0, J3_DEMO=0, a real public bind address,
# a persistent DB path, your own owner email/name and a strong owner password.
# J3_ADDR=0.0.0.0:8787
# J3_DB=/srv/j3/production/j3.db
# J3_VERSION=v1.0.0
# J3_SEED_DEMO=0
# J3_DEMO=0
# J3_OWNER_EMAIL=CHANGE_ME@example.com
# J3_OWNER_NAME=CHANGE_ME Tournament
# J3_OWNER_PASSWORD=CHANGE_ME_USE_A_GITHUB_SECRET
# J3_CORS_ORIGIN=https://j3.example.com
#
# Public HTTPS API baked into hosted mobile clients (GitHub *variable*, not secret):
# J3_SERVER_URL=https://api.example.com
# VITE_API_BASE_URL=https://api.example.com
# VITE_OFFLINE_DEMO=0
# VITE_QA_AUTOLOGIN=0

# ---------------------------------------------------------------------------
# Deployment (GitHub secrets read by scripts/deploy.sh)
# ---------------------------------------------------------------------------
DEPLOY_HOST=CHANGE_ME
DEPLOY_USER=CHANGE_ME
DEPLOY_PATH=/srv/j3
# DEPLOY_SSH_KEY=CHANGE_ME_PASTE_PRIVATE_KEY_IN_GITHUB_SECRET_ONLY

# ---------------------------------------------------------------------------
# Production mobile signing (GitHub secrets only — NEVER commit real values)
# ---------------------------------------------------------------------------
# ANDROID_KEYSTORE_BASE64=CHANGE_ME_BASE64_OF_UPLOAD_KEYSTORE
# ANDROID_KEYSTORE_PASSWORD=CHANGE_ME
# ANDROID_KEY_ALIAS=CHANGE_ME
# ANDROID_KEY_PASSWORD=CHANGE_ME
#
# APPLE_CERTIFICATE_P12=CHANGE_ME_BASE64_OF_P12
# APPLE_CERTIFICATE_PASSWORD=CHANGE_ME
# APPLE_PROVISIONING_PROFILE=CHANGE_ME_BASE64_OF_MOBILEPROVISION
# APPLE_PROVISIONING_PROFILE_NAME=CHANGE_ME_OPTIONAL
# APPLE_TEAM_ID=CHANGE_ME
# APPLE_EXPORT_METHOD=ad-hoc

# Mapping for GitHub Actions:
#   Repo variable J3_SERVER_URL  → public HTTPS backend URL for released clients
#   Repo secret DEPLOY_*         → deployment host/user/path/SSH key
#   Repo secret ANDROID_*        → stable APK signing key (optional; runner debug key fallback)
#   Repo secret APPLE_*          → signed real-device IPA (optional; simulator .app always built)
# Never put DEPLOY_SSH_KEY, J3_OWNER_PASSWORD, keystore or P12 values in a workflow file.
