# Copy to .env.mobile (git-ignored) or export. Real Android/iOS.
# local dev: J3_SERVER_URL=http://<LAN-IP>:8787 ; QA: blank offline ; prod: https://api.example.com
J3_SERVER_URL=
J3_DEV_API_URL=http://CHANGE_ME-LAN-IP:8787
VITE_API_BASE_URL=
VITE_OFFLINE_DEMO=0          # QA APK uses scripts/mobile.sh -> 1 + bundled data
VITE_QA_AUTOLOGIN=0
VITE_QA_FULL_PHONE=0
VITE_BUILD_FLAVOR=prod
J3_VERSION_CHANNEL=release
J3_VERSION_NAME=0.8.0
J3_VERSION_CODE=8002
ANDROID_HOME=/path/to/Android/Sdk
JAVA_HOME=/path/to/jdk-21
# real device CORS must include app origin http://localhost + capacitor://localhost + http://<LAN-IP>
