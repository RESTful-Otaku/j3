# Copy to .env.production (git-ignored). Production/live. Replace CHANGE_ME. Use GitHub secrets for secrets.
J3_ADDR=0.0.0.0:8787
J3_DB=/srv/j3/production/j3.db
J3_VERSION=0.8.0
J3_VERSION_CHANNEL=release
J3_SEED_DEMO=0
J3_DEMO=0
J3_OWNER_EMAIL=CHANGE_ME@example.com
J3_OWNER_NAME=CHANGE_ME Tournament
J3_OWNER_PASSWORD=CHANGE_ME_strong_secret   # or GitHub secret; blank once -> generated + forced change
J3_CORS_ORIGIN=https://example.com,https://api.example.com
J3_SERVER_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
VITE_OFFLINE_DEMO=0
VITE_QA_AUTOLOGIN=0
VITE_QA_FULL_PHONE=0
VITE_BUILD_FLAVOR=prod
J3_PROD_API_URL=https://api.example.com
# Deployment (GitHub secrets preferred)
DEPLOY_HOST=CHANGE_ME
DEPLOY_USER=CHANGE_ME
DEPLOY_PATH=/srv/j3
# DEPLOY_SSH_KEY=CHANGE_ME_private_key_github_secret_only
# Android production signing (GitHub secrets)
# ANDROID_KEYSTORE_BASE64=...
# ANDROID_KEYSTORE_PASSWORD=...
# ANDROID_KEY_ALIAS=...
# ANDROID_KEY_PASSWORD=...
# iOS production (GitHub secrets)
# APPLE_CERTIFICATE_P12=...
# APPLE_CERTIFICATE_PASSWORD=...
# APPLE_PROVISIONING_PROFILE=...
# APPLE_TEAM_ID=...
# APPLE_EXPORT_METHOD=ad-hoc
