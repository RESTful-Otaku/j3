{
  "name": "j3",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "demo": "bash scripts/demo.sh",
    "demo:full": "J3_SEED_FULL=1 bash scripts/demo.sh",
    "seed:full": "go run ./cmd/j3d reset -okami -full -db ./data/j3-demo.db",
    "api": "go run ./cmd/j3d -addr 127.0.0.1:8787 -db ./data/j3-demo.db -seed",
    "seed": "go run ./cmd/j3d seed -db ./data/j3-demo.db",
    "reset": "go run ./cmd/j3d reset -db ./data/j3-demo.db",
    "generate:types": "bun run --cwd web generate:types",
    "test": "go test ./... && bun run --cwd web test",
    "smoke": "bash scripts/smoke.sh",
    "smoke:full": "SMOKE_FULL=1 bash scripts/smoke.sh",
    "e2e": "bun run --cwd web e2e",
    "load": "bash scripts/load.sh",
    "e2e:install": "bunx --cwd web playwright install chromium",
    "check": "bun run --cwd web check",
    "build": "go build ./... && bun run sync:api-docs && bun run --cwd web build",
    "mobile:sync": "bun run --cwd web build && bunx --cwd web cap sync",
    "mobile:android": "bun run mobile:sync && bunx --cwd web cap build android",
    "mobile:ios": "bun run mobile:sync && bunx --cwd web cap build ios",
    "check:workflows": "python3 scripts/check-workflows.py",
    "sync:api-docs": "bash scripts/sync-api-docs.sh"
  }
}
