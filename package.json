{
  "name": "j3",
  "private": true,
  "version": "0.8.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "demo": "bash scripts/demo.sh",
    "demo:full": "J3_SEED_FULL=1 bash scripts/demo.sh",
    "seed:full": "go run ./cmd/j3d reset -okami -full -db ./data/j3-demo.db",
    "api": "J3_DEMO=1 go run ./cmd/j3d -addr 127.0.0.1:8787 -db ./data/j3-demo.db -seed",
    "seed": "go run ./cmd/j3d seed -db ./data/j3-demo.db",
    "reset": "go run ./cmd/j3d reset -db ./data/j3-demo.db",
    "generate:types": "bun run --cwd web generate:types",
    "docs": "bash scripts/docs.sh",
    "test": "go test ./... && bun run --cwd web test",
    "smoke": "bash scripts/smoke.sh",
    "smoke:full": "SMOKE_FULL=1 bash scripts/smoke.sh",
    "e2e": "bun run --cwd web e2e",
    "load": "bash scripts/load.sh",
    "e2e:install": "bunx --cwd web playwright install chromium",
    "check": "bun run --cwd web check",
    "build": "bash scripts/local-build.sh web",
    "build:dev": "bash scripts/build-flavors.sh dev",
    "build:qa": "bash scripts/build-flavors.sh qa",
    "build:prod": "bash scripts/build-flavors.sh prod",
    "build:flavors": "bash scripts/build-flavors.sh all",
    "build:server": "bash scripts/local-build.sh server",
    "build:local": "bash scripts/local-build.sh all",
    "build:android": "bash scripts/mobile.sh build-qa",
    "build:android:dev": "bash scripts/mobile.sh build-dev",
    "build:android:qa": "bash scripts/mobile.sh build-qa",
    "build:android:prod": "bash scripts/mobile.sh build-prod",
    "build:android:flavors": "bash scripts/mobile.sh build-android-all",
    "build:ios": "bash scripts/mobile.sh build-ios-qa",
    "build:ios:dev": "bash scripts/mobile.sh build-ios-dev",
    "build:ios:qa": "bash scripts/mobile.sh build-ios-qa",
    "build:ios:prod": "bash scripts/mobile.sh build-ios-prod",
    "build:ios:flavors": "bash scripts/mobile.sh build-ios-all",
    "mobile:sync": "bun run --cwd web build && bunx --cwd web cap sync",
    "mobile:android": "bun run mobile:sync && bunx --cwd web cap build android",
    "mobile:ios": "bun run mobile:sync && bunx --cwd web cap build ios",
    "check:workflows": "python3 scripts/check-workflows.py",
    "sync:api-docs": "bash scripts/sync-api-docs.sh",
    "release": "bash scripts/release.sh",
    "cicd": "bash scripts/cicd.sh",
    "test:tui": "bash scripts/test-tui.sh",
    "qa:docker": "bash scripts/qa-docker.sh up",
    "qa:docker:full": "bash scripts/qa-docker.sh full",
    "qa:docker:okami": "bash scripts/qa-docker.sh okami",
    "qa:docker:clean": "bash scripts/qa-docker.sh clean",
    "qa:docker:light": "bash scripts/qa-docker.sh light",
    "qa:docker:dev": "bash scripts/qa-docker.sh dev",
    "qa:docker:down": "bash scripts/qa-docker.sh down",
    "qa:docker:reset": "bash scripts/qa-docker.sh reset",
    "qa:docker:simulate": "bash scripts/qa-docker.sh simulate",
    "qa:docker:logs": "bash scripts/qa-docker.sh logs",
    "qa:docker:url": "bash scripts/qa-docker.sh url",
    "db:fresh": "bash scripts/db.sh fresh",
    "db:purge": "bash scripts/db.sh purge",
    "db:seed": "bash scripts/db.sh seed",
    "db:reset": "bash scripts/db.sh reset",
    "db:reseed": "bash scripts/db.sh reseed",
    "db:rebuild": "bash scripts/db.sh rebuild",
    "db:full": "bash scripts/db.sh full",
    "db:existing": "bash scripts/db.sh existing",
    "db:backup": "bash scripts/db.sh backup",
    "simulate:extended": "go run ./cmd/j3d stress",
    "stress": "bash scripts/stress.sh",
    "component:qa": "bash scripts/component-qa.sh",
    "dev:lite": "bash scripts/dev-lite.sh",
    "storybook": "bun run --cwd web storybook",
    "storybook:build": "bun run --cwd web build-storybook",
    "component:storybook": "bun run storybook",
    "version": "bash scripts/version.sh",
    "version:check": "bash scripts/version.sh release check",
    "doctor": "bash scripts/doctor.sh",
    "qa:docker:destroy": "bash scripts/qa-docker.sh destroy",
    "qa:docker:teardown": "bash scripts/qa-docker.sh destroy"
  },
