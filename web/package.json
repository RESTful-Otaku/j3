{
  "name": "j3-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "$lib": "./src/lib/index.ts",
    "$lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --project unit",
    "e2e": "playwright test",
    "generate:types": "openapi-typescript ../api/openapi.yaml -o src/lib/api-types.d.ts",
    "icons": "bash ../scripts/icons.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "storybook": "^10.6.9",
    "@storybook/sveltekit": "^10.6.9",
    "@storybook/addon-svelte-csf": "latest",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "playwright": "latest"
  }
}
