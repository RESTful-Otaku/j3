# Copy to .env.local (git-ignored). Load: set -a; source .env.local; set +a
# Linux/WSL. Replace CHANGE_ME. Never commit real secrets.
J3_ADDR=127.0.0.1:8787
J3_DB=./data/j3.db
J3_VERSION=0.8.0
J3_SEED_DEMO=1
J3_DEMO=1
J3_OWNER_EMAIL=j3@local
J3_OWNER_NAME=J3 Owner
J3_OWNER_PASSWORD=            # blank QA -> one-time generated; production CHANGE_ME_strong
J3_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
J3_SERVER_URL=                # clients: blank=same-origin; production https://api.example.com
VITE_API_BASE_URL=
VITE_API_TARGET=http://127.0.0.1:8787
VITE_OFFLINE_DEMO=1
VITE_QA_AUTOLOGIN=1
VITE_QA_FULL_PHONE=1
VITE_BUILD_FLAVOR=dev
J3_VERSION_CHANNEL=release
